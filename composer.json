{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "svr/financial",
    "description": "Integración reutilizable de pagos y facturación para aplicaciones Laravel.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "facturapi/facturapi-php": "^4.7",
        "illuminate/contracts": "^12.0",
        "illuminate/support": "^12.0",
        "openpay/sdk": "3.1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "SVR\\Financial\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SVR\\Financial\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "SVR\\Financial\\FinancialServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
